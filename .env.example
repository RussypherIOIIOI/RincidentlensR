# Offline mode is the default. Do not use NEXT_PUBLIC_ for these values.
INCIDENTLENS_LIVE_MODE=disabled

# Optional local DEVELOPMENT use only (npm run dev binds 127.0.0.1).
# Set INCIDENTLENS_LIVE_MODE=local to opt in, then provide both:
OPENAI_API_KEY=
# Choose a model available to your project that supports Responses structured outputs.
OPENAI_MODEL=

# Production builds always reject live generation, even if the local toggle is set.
NEXT_TELEMETRY_DISABLED=1
